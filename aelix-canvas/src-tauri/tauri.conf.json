{
  "$schema": "https://schema.tauri.app/config/1",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:1420",
    "distDir": "../dist",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "Aelix Canvas",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "dialog": { "all": false, "open": true, "save": true, "message": true, "ask": true },
      "path": { "all": true },
      "window": { "all": false, "setTitle": true }
    },
    "windows": [
      {
        "title": "Aelix Canvas",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; font-src 'self' https://cdn.jsdelivr.net data:; img-src 'self' data: https:; script-src 'self' 'unsafe-eval' https://cdn.jsdelivr.net; worker-src 'self' blob:; connect-src 'self' https://cdn.jsdelivr.net"
    },
    "bundle": {
      "active": true,
      "identifier": "com.aelixstudio.canvas",
      "targets": "all",
      "category": "DeveloperTool",
      "shortDescription": "Visual cross-platform UI IDE",
      "longDescription": "Aelix Canvas — drag-and-drop visual IDE that generates runnable Flutter, SwiftUI, Compose, and HTML source from one IR."
    }
  }
}
