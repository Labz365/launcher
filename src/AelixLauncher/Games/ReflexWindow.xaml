<Window x:Class="AelixLauncher.Games.ReflexWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reflex — Aelix Arcade" Width="560" Height="660"
        Icon="pack://application:,,,/Assets/icon.ico"
        Background="{StaticResource BgBrush}" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="40,28,40,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Style="{StaticResource Eyebrow}" Text="A E L I X   A R C A D E"/>
                <TextBlock Style="{StaticResource DisplayTitle}" FontSize="40" Margin="-1,8,0,0">
                    <Run Text="Reflex"/><Run FontStyle="Italic" Foreground="{StaticResource AccentBrush}" Text="."/>
                </TextBlock>
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <TextBlock x:Name="ScoreText" Style="{StaticResource MonoMeta}" FontSize="13"
                           Foreground="{StaticResource TextBrush}" HorizontalAlignment="Right" Text="HITS 000"/>
                <TextBlock x:Name="TimeText" Style="{StaticResource MonoMeta}" HorizontalAlignment="Right"
                           Margin="0,4,0,0" Text="TIME 30.0"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Hairline}" Margin="0,18,0,18"/>

        <Border Grid.Row="2" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
                HorizontalAlignment="Center" VerticalAlignment="Top">
            <Grid>
                <Canvas x:Name="Field" Width="440" Height="440" Background="#1A1A1A"/>
                <Border x:Name="Overlay" Background="#D9161616" Width="440" Height="440">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="OverlayTitle" Style="{StaticResource DisplayTitle}" FontSize="34"
                                   FontStyle="Italic" Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center" Text="Thirty seconds."/>
                        <TextBlock x:Name="OverlayHint" Style="{StaticResource MonoMeta}" Margin="0,12,0,0"
                                   HorizontalAlignment="Center" Text="CLICK TO START"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <TextBlock Grid.Row="3" Style="{StaticResource MonoMeta}" HorizontalAlignment="Center" Margin="0,16,0,0"
                   Text="CLICK THE TARGETS BEFORE THEY FADE · ESC — CLOSE"/>
    </Grid>
</Window>
