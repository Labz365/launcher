<Window x:Class="AelixNotes.NameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aelix Notes" Width="380" SizeToContent="Height" ResizeMode="NoResize"
        Background="{StaticResource BgBrush}" WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow" ShowInTaskbar="False">
    <StackPanel Margin="26,20,26,22">
        <TextBlock x:Name="PromptText" FontFamily="Consolas" FontSize="10"
                   Foreground="{StaticResource AccentBrush}" Text="NAME"/>
        <TextBox x:Name="NameBox" Margin="0,12,0,0" Padding="2,6"
                 Background="Transparent" Foreground="{StaticResource TextBrush}"
                 CaretBrush="{StaticResource AccentBrush}" SelectionBrush="{StaticResource AccentBrush}"
                 BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1"
                 FontFamily="Segoe UI" FontSize="14" KeyDown="NameBox_KeyDown"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Style="{StaticResource GhostButton}" Content="Cancel" Margin="0,0,14,0" Click="Cancel_Click"/>
            <Button Style="{StaticResource GhostButton}" Foreground="{StaticResource AccentBrush}"
                    Content="OK" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
