<Window x:Class="AelixNotes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aelix Notes" Height="640" Width="760" MinHeight="360" MinWidth="420"
        Background="{StaticResource BgBrush}" WindowStartupLocation="CenterScreen">
    <Grid Margin="44,30,44,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock FontFamily="Consolas" FontSize="10" Foreground="{StaticResource AccentBrush}"
                       Text="A E L I X   S T U D I O"/>
            <TextBlock FontFamily="Georgia" FontSize="34" FontWeight="Light" Margin="-1,8,0,0"
                       Foreground="{StaticResource TextBrush}">
                <Run Text="Notes"/><Run FontStyle="Italic" Foreground="{StaticResource AccentBrush}" Text="."/>
            </TextBlock>
        </StackPanel>

        <Border Grid.Row="1" Height="1" Background="{StaticResource HairlineBrush}" Margin="0,16,0,16"
                SnapsToDevicePixels="True"/>

        <TextBox x:Name="Editor" Grid.Row="2"
                 Background="Transparent" Foreground="{StaticResource TextBrush}"
                 CaretBrush="{StaticResource AccentBrush}" SelectionBrush="{StaticResource AccentBrush}"
                 BorderThickness="0" FontFamily="Segoe UI" FontSize="14"
                 TextWrapping="Wrap" AcceptsReturn="True" AcceptsTab="True" Padding="0"
                 VerticalScrollBarVisibility="Auto" SpellCheck.IsEnabled="False"
                 TextChanged="Editor_TextChanged"/>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <TextBlock x:Name="StatusText" FontFamily="Consolas" FontSize="10"
                       Foreground="{StaticResource TextDimBrush}" Text="SAVED"/>
            <TextBlock x:Name="CountText" FontFamily="Consolas" FontSize="10" HorizontalAlignment="Right"
                       Foreground="{StaticResource TextDimBrush}" Text="0 WORDS"/>
        </Grid>
    </Grid>
</Window>
