<Window x:Class="AelixNotes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aelix Notes" Height="680" Width="1040" MinHeight="420" MinWidth="760"
        Icon="pack://application:,,,/Assets/icon.ico"
        Background="{StaticResource BgBrush}" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="208"/>
            <ColumnDefinition Width="236"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── NOTEBOOKS ── -->
        <Border Grid.Column="0" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="18,24,18,4">
                    <TextBlock FontFamily="Consolas" FontSize="10" Foreground="{StaticResource AccentBrush}"
                               Text="A E L I X"/>
                    <TextBlock FontFamily="Georgia" FontSize="26" FontWeight="Light" Margin="-1,6,0,0"
                               Foreground="{StaticResource TextBrush}">
                        <Run Text="Notes"/><Run FontStyle="Italic" Foreground="{StaticResource AccentBrush}" Text="."/>
                    </TextBlock>
                </StackPanel>

                <Grid Grid.Row="1" Margin="18,16,12,6">
                    <TextBlock Style="{StaticResource MonoMeta}" Text="NOTEBOOKS" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource GhostButton}" Content="+ New" HorizontalAlignment="Right"
                            Click="NewNotebook_Click"/>
                </Grid>

                <ListBox x:Name="NotebookList" Grid.Row="2" Margin="4,0"
                         SelectionChanged="NotebookList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Rename" Click="RenameNotebook_Click"/>
                                        <MenuItem Header="Delete" Click="DeleteNotebook_Click"/>
                                    </ContextMenu>
                                </Grid.ContextMenu>
                                <TextBlock Text="{Binding Name}" FontFamily="Segoe UI" FontSize="13"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding CountLabel}" Style="{StaticResource MonoMeta}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="3" Style="{StaticResource MonoMeta}" Margin="18,8,18,14"
                           Text="AELIX STUDIO · EST. 2026"/>
            </Grid>
        </Border>

        <!-- ── NOTES ── -->
        <Border Grid.Column="1" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="18,28,12,6">
                    <TextBlock x:Name="NotesHeader" Style="{StaticResource MonoMeta}" Text="NOTES"
                               VerticalAlignment="Center"/>
                    <Button Style="{StaticResource GhostButton}" Content="+ New" HorizontalAlignment="Right"
                            Click="NewNote_Click"/>
                </Grid>

                <ListBox x:Name="NoteList" Grid.Row="1" Margin="4,0,4,8"
                         SelectionChanged="NoteList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <StackPanel.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Rename" Click="RenameNote_Click"/>
                                        <MenuItem Header="Delete" Click="DeleteNote_Click"/>
                                    </ContextMenu>
                                </StackPanel.ContextMenu>
                                <TextBlock Text="{Binding Title}" FontFamily="Segoe UI" FontSize="13"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Preview}" Style="{StaticResource MonoMeta}"
                                           Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- ── EDITOR ── -->
        <Grid Grid.Column="2" Margin="32,24,32,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="EditorTitle" Grid.Row="0" FontFamily="Georgia" FontSize="26" FontWeight="Light"
                       Foreground="{StaticResource TextBrush}" Text="" TextTrimming="CharacterEllipsis"/>

            <Border Grid.Row="1" Height="1" Background="{StaticResource HairlineBrush}" Margin="0,14,0,16"
                    SnapsToDevicePixels="True"/>

            <TextBox x:Name="Editor" Grid.Row="2"
                     Background="Transparent" Foreground="{StaticResource TextBrush}"
                     CaretBrush="{StaticResource AccentBrush}" SelectionBrush="{StaticResource AccentBrush}"
                     BorderThickness="0" FontFamily="Segoe UI" FontSize="14"
                     TextWrapping="Wrap" AcceptsReturn="True" AcceptsTab="True" Padding="0"
                     VerticalScrollBarVisibility="Auto" SpellCheck.IsEnabled="False"
                     TextChanged="Editor_TextChanged" IsEnabled="False"/>

            <Grid Grid.Row="3" Margin="0,12,0,0">
                <TextBlock x:Name="StatusText" Style="{StaticResource MonoMeta}" Text=""/>
                <TextBlock x:Name="CountText" Style="{StaticResource MonoMeta}" HorizontalAlignment="Right" Text=""/>
            </Grid>
        </Grid>
    </Grid>
</Window>
