<Application x:Class="AelixNotes.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="BgBrush" Color="#161616"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F2EDE8"/>
        <SolidColorBrush x:Key="TextDimBrush" Color="#61F2EDE8"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#DDD0C4"/>
        <SolidColorBrush x:Key="HairlineBrush" Color="#1AF2EDE8"/>
    </Application.Resources>
</Application>
